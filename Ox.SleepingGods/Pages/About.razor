<p>
	Version: @BuildInfo
</p>

@code {
	public string BuildInfo
	{
		get
		{
			var ass = System.Reflection.Assembly.GetExecutingAssembly();
			var version = ass.GetName().Version;
			string info = version != null ? new DateTime(2000, 1, 1).AddDays(version.Build).AddSeconds(version.Revision * 2).ToString("u") : version!.ToString();

			return info + " - " + ass.ManifestModule.ModuleVersionId.ToString();
		}
	}
}
