@inject Data.KeywordRepository keywordRepo;
@inject Data.KeywordLocationRepository keywordLocationRepository;
@inject NavigationManager Navigator;
@inject Data.KeywordStateManager stateManager;
@page "/Keywords"
@using Microsoft.AspNetCore.Components.Sections
@using Ox.SleepingGods.Components

<PageTitle>Quests and Keywords - Sleeping Gods Companion</PageTitle>

<SectionContent SectionName="page-title">Keywords</SectionContent>

<h3>Keywords</h3>

<div id="NewQuest">
	<EditForm Model="@newKeyword" OnValidSubmit="@Submit" FormName="newquest" id="fnar">
		<DataAnnotationsValidator />
		<ValidationSummary />
		<InputText @bind-Value="newKeyword!.Id" class="keyword" placeholder="New Keyword" />
		<button type="submit">+</button>
	</EditForm>
</div>

<fieldset>
	<legend>Filter</legend>
	<input type="text" @oninput="this.FilterAsync" class="keyword" placeholder="Search" />

	
	<select @bind="stateManager.QuestFilter" @bind:after="DisplayData">
		<option value="">Types</option>
		@foreach (var r in Enum.GetValues<Models.Data.KeywordType>())
		{
			<option>@r</option>
		}
	</select>
</fieldset>

@foreach(var r in this.keywords)
{
	<KeywordInfo @key="r" Keyword="r" />
}

@code {

	[SupplyParameterFromForm]
	private Models.Data.Keyword? newKeyword { get; set; } = new();

	private List<Models.Data.Keyword> keywords = new(206);

	private SemaphoreSlim semaphore = new(1);

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		await DisplayData();
	}

	protected async Task FilterAsync(ChangeEventArgs eventArgs)
	{
		var filter = eventArgs.Value as String;
		if(String.IsNullOrWhiteSpace(filter))
			this.keywords = await this.keywordRepo.GetAll();
		else
			this.keywords = (await this.keywordRepo.GetAll()).Where(k => k.Id!.Contains(filter.ToUpper())).ToList();
	}

	public async Task Submit()
	{
		if (this.newKeyword != null)
		{
			await this.keywordRepo.Add(this.newKeyword);
			this.keywords.Add(this.newKeyword);
		}
		this.newKeyword = new();
	}

	private async Task DisplayData()
	{
		await this.semaphore.WaitAsync();
		try
		{
			this.keywords.Clear();
			await foreach (var kw in this.keywordRepo.GetAllAsync())
			{
				if (!stateManager.QuestFilter.HasValue || stateManager.QuestFilter == kw.KeywordType)
					this.keywords.Add(kw);

				StateHasChanged();
			}
		}
		catch(Exception ex)
		{
			throw ex;
		}
		finally
		{

			this.semaphore.Release();
		}
	}
}
